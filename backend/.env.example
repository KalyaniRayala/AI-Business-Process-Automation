# Copy this file to .env and fill in your own values.
# Never commit .env.

# Required: Cohere API key (LLM + embeddings)
COHERE_API_KEY=your-cohere-api-key

# Optional: logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: log output. "text" (default) is readable in a terminal;
# "json" writes one JSON object per line for a log collector.
# Both carry the request id and redact credentials.
# LOG_FORMAT=text

# Optional: relational database (defaults to SQLite at data/business.db)
# DATABASE_URL=sqlite:///data/business.db
# PostgreSQL, placeholder values only:
# DATABASE_URL=postgresql+psycopg://bpa_app:your-password@localhost:5432/bpa

# Optional: run the test suite against a separate, disposable
# PostgreSQL database (never the one in DATABASE_URL). Set it in
# your shell when running pytest.
# TEST_DATABASE_URL=postgresql+psycopg://bpa_app:your-password@localhost:5432/bpa_test

# Optional: vector store path (used by the test suite for isolation)
# CHROMA_PATH=chroma_db

# Optional: Microsoft Entra ID connector (python -m app.services.connectors sync entra).
# Register an application in Entra ID, grant it the Microsoft Graph application
# permission User.Read.All (admin consent), and create a client secret.
# Placeholder values only; keep real values in .env, never in code.
# ENTRA_TENANT_ID=your-tenant-id
# ENTRA_CLIENT_ID=your-application-client-id
# ENTRA_CLIENT_SECRET=your-client-secret
# ENTRA_AUTHORITY_URL=https://login.microsoftonline.com
# ENTRA_GRAPH_URL=https://graph.microsoft.com/v1.0

# Optional: connector HTTP behaviour (defaults shown)
# CONNECTOR_TIMEOUT_SECONDS=15
# CONNECTOR_MAX_RETRIES=3
# CONNECTOR_MAX_PAGES=100
