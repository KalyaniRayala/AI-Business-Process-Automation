# Copy to .env in this directory (the project root) for Docker Compose.
# Compose reads it automatically. Never commit .env: it is git-ignored.
#
# This file is for the containers. backend/.env stays as it is and is
# used when you run the backend directly; it is excluded from the image.

# Required: Cohere API key (LLM + embeddings).
COHERE_API_KEY=your-cohere-api-key

# Required: the password for the PostgreSQL container. Choose your
# own; compose refuses to start without it rather than using a
# default that would be the same on every machine.
POSTGRES_PASSWORD=choose-a-password

# Optional: database user and name (defaults shown).
# POSTGRES_USER=bpa_app
# POSTGRES_DB=bpa

# Optional: host ports (defaults shown). The backend is published on
# 127.0.0.1 only.
# FRONTEND_PORT=8080
# BACKEND_PORT=8000

# Optional: logging (defaults shown for the containers).
# LOG_LEVEL=INFO
# LOG_FORMAT=json
